page {
  background: #F7F5F0;
  color: #33302A;
  font-size: 30rpx;
  line-height: 1.7;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.hero {
  padding: 36rpx 28rpx;
  border-radius: 16rpx;
  background: #B08D57;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 500;
}
.hero-sub {
  font-size: 26rpx;
  opacity: .9;
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.q-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}
.q-hint {
  font-size: 24rpx;
  color: #8A8175;
  font-weight: 400;
}

.opt-grid {
  display: flex;
  flex-wrap: wrap;
}
.opt {
  width: 46%;
  margin: 0 2% 16rpx;
  padding: 18rpx 16rpx;
  border: 2rpx solid #E6DFD3;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.opt.on {
  border-color: #B08D57;
  background: rgba(176, 141, 87, .07);
}
.opt-label {
  font-size: 28rpx;
}
.opt-hint {
  font-size: 22rpx;
  color: #8A8175;
  margin-top: 4rpx;
}

.opt-row {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  padding: 14rpx 24rpx;
  border: 2rpx solid #E6DFD3;
  border-radius: 40rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}
.chip.on {
  border-color: #B08D57;
  background: rgba(176, 141, 87, .07);
  color: #8C6D3F;
}

.btn-row {
  display: flex;
  margin: 12rpx 0 32rpx;
}
.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.btn.primary {
  background: #B08D57;
  color: #fff;
  margin-left: 16rpx;
}
.btn.ghost {
  border: 2rpx solid #E6DFD3;
  color: #8A8175;
}
.btn.sm {
  flex: none;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.result {
  animation: none;
}
.result-head {
  font-size: 34rpx;
  font-weight: 500;
  margin: 8rpx 0 20rpx;
}

.r-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.r-card.warn {
  background: rgba(186, 117, 23, .07);
  border: 2rpx solid rgba(186, 117, 23, .25);
}
.r-card.subtle {
  background: transparent;
}
.r-label {
  font-size: 24rpx;
  color: #8A8175;
}
.r-value {
  font-size: 34rpx;
  font-weight: 500;
  color: #8C6D3F;
  margin: 6rpx 0;
}
.r-value.sm {
  font-size: 30rpx;
}
.r-meta {
  font-size: 26rpx;
  color: #8A8175;
}
.r-note {
  font-size: 26rpx;
  color: #6B6357;
  margin-top: 12rpx;
}
.r-models {
  margin-top: 14rpx;
}
.r-model {
  font-size: 26rpx;
  color: #6B6357;
}

.r-row {
  display: flex;
  margin-bottom: 20rpx;
}
.r-cell {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-right: 16rpx;
}
.r-cell:last-child {
  margin-right: 0;
}

.warn-item {
  font-size: 26rpx;
  color: #633806;
  margin-bottom: 14rpx;
}

.follow {
  margin-top: 40rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #E6DFD3;
}
.follow-title {
  font-size: 30rpx;
  font-weight: 500;
}
.follow-desc {
  font-size: 26rpx;
  color: #6B6357;
  margin-top: 10rpx;
}
.follow-desc.dim {
  color: #8A8175;
}

.h {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.p {
  font-size: 26rpx;
  color: #6B6357;
  margin-bottom: 14rpx;
}
